---
/**
 * StorageSize — horizontal bar chart comparing coverage database sizes
 */

const bars = [
  { label: 'UCIS XML', size: '150 MB', pct: 100, color: 'var(--diag-source)', highlight: false },
  { label: 'SQLite',   size: '85 MB',  pct: 57,  color: 'var(--diag-source)', highlight: false },
  { label: 'NCDB',     size: '1.5 MB', pct: 1.0, color: 'var(--diag-core)',   highlight: true  },
];

const W = 400, H = 140;
const labelW = 74, sizeW = 54, barAreaW = W - labelW - sizeW - 12;
const rowH = 34, topPad = 16;
---

<div>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    class="diagram-svg w-full max-w-md"
    role="img"
    aria-label="Storage size comparison: UCIS XML 150MB, SQLite 85MB, NCDB 1.5MB"
    id="storage-chart"
  >
    {bars.map((bar, i) => {
      const y = topPad + i * rowH;
      const barW = (bar.pct / 100) * barAreaW;
      const barX = labelW;
      const barY = y + 6;
      const barH = 18;

      return (
        <>
          {/* Row label */}
          <text x={labelW - 6} y={barY + barH / 2 + 4} text-anchor="end"
            font-size="10.5" font-weight={bar.highlight ? '700' : '500'}
            fill={bar.highlight ? 'var(--diag-core)' : 'var(--diag-text)'}
          >{bar.label}</text>

          {/* Bar track */}
          <rect x={barX} y={barY} width={barAreaW} height={barH} rx="3"
            fill="var(--diag-source)" opacity="0.12" />

          {/* Bar fill — CSS sets full width; JS animates from 0 on scroll */}
          <rect
            class="bar-fill"
            data-target-width={barW}
            x={barX} y={barY} width={barW} height={barH} rx="3"
            fill={bar.color}
            opacity={bar.highlight ? '1' : '0.7'}
            style={`width:${barW}px`}
          />

          {/* Highlight border */}
          {bar.highlight && (
            <rect x={barX} y={barY} width={barAreaW} height={barH} rx="3"
              fill="none" stroke="var(--diag-core)" stroke-width="1.5" opacity="0.4" />
          )}

          {/* Size label */}
          <text x={barX + barAreaW + 6} y={barY + barH / 2 + 4}
            font-size="10" font-weight={bar.highlight ? '700' : '400'}
            fill={bar.highlight ? 'var(--diag-core)' : 'var(--diag-text)'}
          >{bar.size}</text>

          {/* "60-73× smaller" annotation on NCDB V2 */}
          {bar.highlight && (
            <>
              <line x1={barX + barW + 2} y1={barY + barH / 2} x2={barX + barW + 22} y2={barY - 6}
                stroke="var(--diag-core)" stroke-width="1" stroke-dasharray="2 2" />
              <text x={barX + barW + 24} y={barY - 8}
                font-size="9" font-weight="700" fill="var(--diag-core)">60–73× smaller</text>
            </>
          )}
        </>
      );
    })}
  </svg>

  <script>
    // Animate bar widths in when the chart scrolls into view
    const chart = document.getElementById('storage-chart');
    if (chart) {
      // Start bars at 0 before animating
      chart.querySelectorAll<SVGRectElement>('.bar-fill').forEach((rect) => {
        rect.setAttribute('width', '0');
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            chart.querySelectorAll<SVGRectElement>('.bar-fill').forEach((rect) => {
              const target = parseFloat(rect.dataset.targetWidth ?? '0');
              rect.animate(
                [{ width: '0px' }, { width: `${target}px` }],
                { duration: 700, easing: 'ease-out', fill: 'forwards' }
              );
            });
            observer.disconnect();
          }
        });
      }, { threshold: 0.3 });
      observer.observe(chart);
    }
  </script>
</div>
