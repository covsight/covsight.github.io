---
/**
 * IntelligenceLoop — circular verification feedback loop
 * CovSight-owned stages are highlighted in brand teal.
 */

const stages = [
  { label: 'Run\nSimulation',         covsight: false },
  { label: 'Collect\nCoverage',       covsight: true  },
  { label: 'Analyze\nGaps',           covsight: true  },
  { label: 'Prioritize &\nWrite Tests', covsight: false },
];

const W = 360, H = 300;
const cx = W / 2, cy = H / 2 - 10;
const radius = 100;
const nodeR = 40;

function stagePos(i: number) {
  // Start from top, go clockwise
  const angle = (i / stages.length) * 2 * Math.PI - Math.PI / 2;
  return {
    x: cx + radius * Math.cos(angle),
    y: cy + radius * Math.sin(angle),
  };
}

const positions = stages.map((_, i) => stagePos(i));
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  class="diagram-svg w-full max-w-sm"
  role="img"
  aria-label="Verification feedback loop: Run Simulation, Collect Coverage (CovSight), Analyze Gaps (CovSight), Prioritize and Write Tests — repeating cycle"
>
  <defs>
    <marker id="loop-arrow" markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto">
      <path d="M0,0 L0,6 L8,3 z" fill="var(--diag-source)" />
    </marker>
    <marker id="loop-arrow-cs" markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto">
      <path d="M0,0 L0,6 L8,3 z" fill="var(--diag-core)" />
    </marker>
  </defs>

  <!-- Curved arrows between stages (clockwise) -->
  {stages.map((stage, i) => {
    const from = positions[i];
    const to   = positions[(i + 1) % stages.length];
    const next = stages[(i + 1) % stages.length];
    const color = (stage.covsight || next.covsight) ? 'var(--diag-core)' : 'var(--diag-source)';
    const markerId = (stage.covsight || next.covsight) ? 'loop-arrow-cs' : 'loop-arrow';

    // Midpoint offset to create a gentle outward curve
    const midX = (from.x + to.x) / 2;
    const midY = (from.y + to.y) / 2;
    const dx = midX - cx, dy = midY - cy;
    const len = Math.sqrt(dx * dx + dy * dy) || 1;
    const cpX = midX + (dx / len) * 24;
    const cpY = midY + (dy / len) * 24;

    // Shorten start/end so arrow doesn't overlap node circles
    const shrink = nodeR + 4;
    function shorten(from: {x:number,y:number}, to: {x:number,y:number}, dist: number) {
      const dx = to.x - from.x, dy = to.y - from.y;
      const d = Math.sqrt(dx*dx+dy*dy);
      return { x: from.x + dx/d*dist, y: from.y + dy/d*dist };
    }
    const start = shorten(from, { x: cpX, y: cpY }, shrink);
    const end   = shorten(to,   { x: cpX, y: cpY }, shrink);

    return (
      <path
        d={`M${start.x},${start.y} Q${cpX},${cpY} ${end.x},${end.y}`}
        stroke={color} stroke-width="1.8" fill="none"
        marker-end={`url(#${markerId})`}
      />
    );
  })}

  <!-- Stage nodes -->
  {stages.map((stage, i) => {
    const p = positions[i];
    const lines = stage.label.split('\n');
    return (
      <>
        <circle cx={p.x} cy={p.y} r={nodeR}
          fill={stage.covsight ? 'var(--diag-core)' : 'var(--diag-bg)'}
          stroke={stage.covsight ? 'var(--diag-core)' : 'var(--diag-source)'}
          stroke-width="2"
          opacity={stage.covsight ? '0.2' : '1'}
        />
        {/* Second pass for text contrast */}
        <circle cx={p.x} cy={p.y} r={nodeR}
          fill="none"
          stroke={stage.covsight ? 'var(--diag-core)' : 'var(--diag-source)'}
          stroke-width="2"
        />
        {lines.map((line, li) => (
          <text
            x={p.x} y={p.y + (li - (lines.length - 1) / 2) * 13 + 4}
            text-anchor="middle"
            font-size="9.5"
            font-weight={stage.covsight ? '700' : '500'}
            fill={stage.covsight ? 'var(--diag-core)' : 'var(--diag-text)'}
          >{line}</text>
        ))}
      </>
    );
  })}

  <!-- AI agent annotation near "Analyze Gaps" -->
  {(() => {
    const analyzePos = positions[2];
    const aX = analyzePos.x + nodeR + 12;
    const aY = analyzePos.y - 12;
    return (
      <>
        <line x1={analyzePos.x + nodeR} y1={analyzePos.y} x2={aX} y2={aY}
          stroke="var(--diag-core)" stroke-width="1" stroke-dasharray="3 2" opacity="0.7" />
        <rect x={aX} y={aY - 14} width="74" height="22" rx="4"
          fill="var(--diag-core)" opacity="0.12"
          stroke="var(--diag-core)" stroke-width="1" />
        <text x={aX + 37} y={aY - 2} text-anchor="middle"
          font-size="8.5" font-weight="600" fill="var(--diag-core)">AI Agent / Engineer</text>
      </>
    );
  })()}

  <!-- Center label -->
  <text x={cx} y={cy + 5} text-anchor="middle"
    font-size="9" fill="var(--diag-text)" opacity="0.4" font-style="italic">verification</text>
  <text x={cx} y={cy + 17} text-anchor="middle"
    font-size="9" fill="var(--diag-text)" opacity="0.4" font-style="italic">cycle</text>

  <!-- Legend -->
  <circle cx={20} cy={H - 16} r="6" fill="var(--diag-core)" opacity="0.2" stroke="var(--diag-core)" stroke-width="1.5" />
  <text x={30} y={H - 12} font-size="8.5" fill="var(--diag-core)">CovSight step</text>
</svg>
