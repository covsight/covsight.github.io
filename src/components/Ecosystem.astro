---
import ecosystemData from '../data/ecosystem.yaml';

const data = ecosystemData as {
  section_heading: string;
  intro: string;
  layers: {
    name: string;
    projects: { id: string; label: string; sublabel: string; repo: string }[];
  }[];
  core: { label: string; description: string; repo: string };
};
---

<section
  id="ecosystem"
  class="py-20 bg-white dark:bg-navy-900"
  aria-labelledby="ecosystem-heading"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <h2
      id="ecosystem-heading"
      class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white"
    >
      {data.section_heading}
    </h2>
    <p class="mt-3 text-base text-slate-600 dark:text-slate-300 max-w-2xl">
      {data.intro}
    </p>

    <div class="mt-10 flex flex-col gap-3" role="img" aria-label="CovSight ecosystem layer diagram">

      <!-- Application layers (from yaml) -->
      {data.layers.map((layer) => (
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-2 ml-1">
            {layer.name}
          </p>
          <div class="flex flex-wrap gap-2">
            {layer.projects.map((proj) => (
              <a
                href={proj.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col px-3 py-2 rounded-lg border border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-800 hover:border-brand-400 dark:hover:border-brand-600 hover:bg-brand-50/40 dark:hover:bg-brand-900/10 transition-colors text-left min-w-[130px]"
              >
                <span class="text-xs font-semibold text-slate-700 dark:text-slate-200 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors font-mono">
                  {proj.label}
                </span>
                <span class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">{proj.sublabel}</span>
              </a>
            ))}
          </div>
        </div>
      ))}

      <!-- Connecting visual -->
      <div class="flex justify-center py-1" aria-hidden="true">
        <div class="flex flex-col items-center gap-1">
          <div class="w-px h-4 bg-brand-400/40"></div>
          <svg width="20" height="10" viewBox="0 0 20 10" fill="none">
            <path d="M0 0 L10 10 L20 0" stroke="var(--color-brand)" stroke-width="1.5" stroke-opacity="0.4"/>
          </svg>
        </div>
      </div>

      <!-- covsight-core (foundation layer) -->
      <a
        href={data.core.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex flex-col sm:flex-row sm:items-center gap-2 px-5 py-4 rounded-xl border-2 border-brand-500 dark:border-brand-600 bg-brand-50/50 dark:bg-brand-900/10 hover:bg-brand-50 dark:hover:bg-brand-900/20 transition-colors"
      >
        <span class="text-base font-bold font-mono text-brand-700 dark:text-brand-300 group-hover:text-brand-600 dark:group-hover:text-brand-200 transition-colors">
          {data.core.label}
        </span>
        <span class="hidden sm:block text-slate-300 dark:text-navy-600">·</span>
        <span class="text-sm text-brand-600/80 dark:text-brand-400/80">
          {data.core.description}
        </span>
      </a>

    </div>
  </div>
</section>
