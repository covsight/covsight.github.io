---
import navData from '../data/nav.yaml';

const { links } = navData as {
  links: { label: string; href: string; external?: boolean }[];
};

// Inline the icon SVG rather than loading as an img so it can be CSS-themed
---

<header
  class="fixed top-0 inset-x-0 z-50 bg-white/80 dark:bg-navy-900/80 backdrop-blur-md border-b border-slate-200/60 dark:border-navy-700/60"
>
  <nav
    class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between"
    aria-label="Main navigation"
  >
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-2.5 text-slate-900 dark:text-white hover:text-brand-600 dark:hover:text-brand-400 transition-colors"
      aria-label="CovSight home"
    >
      <!-- CovSight icon 32×32 -->
      <svg
        viewBox="0 0 32 32"
        width="32"
        height="32"
        aria-hidden="true"
        class="flex-shrink-0"
      >
        <defs>
          <clipPath id="cc32">
            <rect x="6.5" y="4.5" width="19" height="14" rx="1.5"/>
          </clipPath>
        </defs>
        <rect width="32" height="32" rx="4.5" fill="#0a192f"/>
        <rect x="6" y="4" width="20" height="15" rx="1.5" fill="#0d2240" stroke="#4a8aaa" stroke-width="1"/>
        <circle cx="8" cy="6" r="0.7" fill="#4a8aaa" opacity="0.7"/>
        <!-- top pins -->
        <line x1="10" y1="4" x2="10" y2="2" stroke="#4a8aaa" stroke-width="1" stroke-linecap="round"/>
        <line x1="22" y1="4" x2="22" y2="2" stroke="#4a8aaa" stroke-width="1" stroke-linecap="round"/>
        <!-- bottom pins -->
        <line x1="10" y1="19" x2="10" y2="21" stroke="#4a8aaa" stroke-width="1" stroke-linecap="round"/>
        <line x1="22" y1="19" x2="22" y2="21" stroke="#4a8aaa" stroke-width="1" stroke-linecap="round"/>
        <!-- left pins -->
        <line x1="6" y1="9"  x2="4" y2="9"  stroke="#4a8aaa" stroke-width="1" stroke-linecap="round"/>
        <line x1="6" y1="14" x2="4" y2="14" stroke="#4a8aaa" stroke-width="1" stroke-linecap="round"/>
        <!-- right pins -->
        <line x1="26" y1="9"  x2="28" y2="9"  stroke="#4a8aaa" stroke-width="1" stroke-linecap="round"/>
        <line x1="26" y1="14" x2="28" y2="14" stroke="#4a8aaa" stroke-width="1" stroke-linecap="round"/>
        <!-- Bar 1 — 90% green -->
        <rect x="8" y="7"    width="16" height="2.5" rx="1.25" fill="#0a2a40" clip-path="url(#cc32)"/>
        <rect x="8" y="7"    width="14" height="2.5" rx="1.25" fill="#22c55e" clip-path="url(#cc32)"/>
        <!-- Bar 2 — 72% amber -->
        <rect x="8" y="10.5" width="16" height="2.5" rx="1.25" fill="#0a2a40" clip-path="url(#cc32)"/>
        <rect x="8" y="10.5" width="11.5" height="2.5" rx="1.25" fill="#f59e0b" clip-path="url(#cc32)"/>
        <!-- Bar 3 — 42% red -->
        <rect x="8" y="14"   width="16" height="2.5" rx="1.25" fill="#0a2a40" clip-path="url(#cc32)"/>
        <rect x="8" y="14"   width="7"  height="2.5" rx="1.25" fill="#ef4444" clip-path="url(#cc32)"/>
        <!-- Wordmark -->
        <text x="16" y="29" font-family="system-ui,-apple-system,sans-serif" font-size="6" text-anchor="middle">
          <tspan font-weight="700" fill="#00c8a8">cov</tspan><tspan fill="#d8ecf6">sight</tspan>
        </text>
      </svg>
      <span class="font-semibold text-lg tracking-tight">CovSight</span>
    </a>

    <!-- Desktop nav links -->
    <div class="hidden md:flex items-center gap-1">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-navy-800 rounded-md transition-colors"
            {...(link.external
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {})}
          >
            {link.label}
          </a>
        ))
      }

      <!-- Dark / light toggle -->
      <button
        id="theme-toggle"
        aria-label="Toggle dark mode"
        class="ml-2 p-2 rounded-md text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-navy-800 transition-colors"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg
          id="icon-sun"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden dark:block"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg
          id="icon-moon"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="block dark:hidden"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </div>

    <!-- Mobile hamburger (toggles #mobile-menu) -->
    <button
      id="mobile-menu-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden p-2 rounded-md text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-navy-800 transition-colors"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <rect y="3"  width="20" height="2" rx="1" />
        <rect y="9"  width="20" height="2" rx="1" />
        <rect y="15" width="20" height="2" rx="1" />
      </svg>
    </button>
  </nav>

  <!-- Mobile dropdown menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-900 px-4 py-3 space-y-1"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class="block px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-navy-800 rounded-md transition-colors"
          {...(link.external
            ? { target: '_blank', rel: 'noopener noreferrer' }
            : {})}
        >
          {link.label}
        </a>
      ))
    }
  </div>
</header>

<script>
  // Dark mode toggle
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Mobile menu toggle
  const mobileBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden') === false;
    mobileBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  // Blur nav background on scroll (already handled by CSS backdrop-blur;
  // add a shadow on scroll for extra depth)
  const header = document.querySelector('header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('shadow-sm', window.scrollY > 8);
  }, { passive: true });
</script>
