---
import interfacesMeta from '../data/interfaces-meta.yaml';
import interfacesData from '../data/interfaces.yaml';
import InterfaceCard from './InterfaceCard.astro';

const meta = interfacesMeta as { section_heading: string; intro: string };
const cards = interfacesData as {
  id: string; name: string; icon: string; description: string; href: string; roadmap?: boolean;
}[];
---

<section
  id="interfaces"
  class="py-20 bg-slate-50 dark:bg-navy-800 border-y border-slate-200 dark:border-navy-700"
  aria-labelledby="interfaces-heading"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <h2
      id="interfaces-heading"
      class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white"
    >
      {meta.section_heading}
    </h2>
    <p class="mt-3 text-base text-slate-600 dark:text-slate-300 max-w-2xl">
      {meta.intro}
    </p>

    <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {cards.map((card) => (
        <InterfaceCard
          name={card.name}
          icon={card.icon}
          description={card.description}
          href={card.href}
          roadmap={card.roadmap}
        />
      ))}
    </div>

  </div>
</section>
