---
export interface Props {
  name: string;
  icon: string;
  description: string;
  href: string;
  roadmap?: boolean;
}

const { name, icon, description, href, roadmap = false } = Astro.props;

// Simple inline SVG icons keyed by icon name
const icons: Record<string, string> = {
  terminal: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="24" height="20" rx="3"/><path d="M7 10l4 4-4 4M14 18h7"/></svg>`,
  dashboard: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="10" height="10" rx="2"/><rect x="16" y="2" width="10" height="10" rx="2"/><rect x="2" y="16" width="10" height="10" rx="2"/><rect x="16" y="16" width="10" height="10" rx="2"/></svg>`,
  vscode:    `<svg width="28" height="28" viewBox="0 0 28 28" fill="currentColor" aria-hidden="true"><path d="M20.25 3l-8.75 8-4-3L3 10.5l5 4-5 4 4.5 2.5 4-3 8.75 8L25 24V4l-4.75-1zM21 20.25L13 14l8-6.25V20.25z"/></svg>`,
  actions:   `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="14" cy="14" r="11"/><path d="M10 10l8 4-8 4V10z"/></svg>`,
  ai:        `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="7" width="14" height="14" rx="3"/><path d="M11 2v5M17 2v5M11 21v5M17 21v5M2 11h5M2 17h5M21 11h5M21 17h5"/><circle cx="14" cy="14" r="2" fill="currentColor"/></svg>`,
  python:    `<svg width="28" height="28" viewBox="0 0 28 28" fill="currentColor" aria-hidden="true"><path d="M14 2c-4 0-7 1.5-7 3.5V9h7v1H5.5C3.5 10 2 12 2 14s1.5 4 3.5 4H7v-3c0-2 2-3.5 7-3.5s7 1.5 7 3.5v7c0 2-3 3.5-7 3.5s-7-1.5-7-3.5V19h4v1.5c0 .8 1.3 1.5 3 1.5s3-.7 3-1.5v-7H7V5.5C7 3.5 10 2 14 2zm0 3.5c-.8 0-1.5.4-1.5 1s.7 1 1.5 1 1.5-.4 1.5-1-.7-1-1.5-1zm0 16c-.8 0-1.5.4-1.5 1s.7 1 1.5 1 1.5-.4 1.5-1-.7-1-1.5-1z"/></svg>`,
};
---

<a
  href={href}
  class:list={[
    "group flex flex-col gap-3 p-5 rounded-xl border bg-white dark:bg-navy-900 transition-all duration-200",
    roadmap
      ? "border-slate-200 dark:border-navy-700 opacity-60 cursor-default pointer-events-none"
      : "border-slate-200 dark:border-navy-700 hover:border-brand-400 dark:hover:border-brand-600 hover:-translate-y-0.5 hover:shadow-md",
  ]}
>
  <div class="flex items-start justify-between gap-2">
    <div class="text-brand-600 dark:text-brand-400 group-hover:text-brand-500 transition-colors">
      <Fragment set:html={icons[icon] ?? icons.terminal} />
    </div>
    {roadmap && (
      <span class="shrink-0 text-xs font-medium px-2 py-0.5 rounded-full bg-slate-100 dark:bg-navy-800 text-slate-400 dark:text-slate-500 border border-slate-200 dark:border-navy-700">
        roadmap
      </span>
    )}
  </div>
  <div>
    <h3 class="font-semibold text-slate-900 dark:text-white text-sm mb-1">{name}</h3>
    <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">{description}</p>
  </div>
  {!roadmap && (
    <span class="mt-auto text-xs font-medium text-brand-600 dark:text-brand-400 group-hover:underline">
      Learn more →
    </span>
  )}
</a>
