---
import problemData from '../data/problem.yaml';

const data = problemData as {
  heading: string;
  intro: string;
  comparison: { without: string; with: string }[];
};
---

<section
  id="problem"
  class="bg-slate-50 dark:bg-navy-800 border-y border-slate-200 dark:border-navy-700 py-20"
  aria-labelledby="problem-heading"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <h2
      id="problem-heading"
      class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white max-w-2xl"
    >
      {data.heading}
    </h2>

    <p class="mt-4 text-base text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
      {data.intro}
    </p>

    <!-- Comparison table -->
    <div class="mt-10 overflow-x-auto rounded-xl border border-slate-200 dark:border-navy-700 shadow-sm">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-200 dark:border-navy-700">
            <th
              scope="col"
              class="px-5 py-3 text-left font-semibold text-red-600 dark:text-red-400 bg-red-50/60 dark:bg-red-900/10 w-1/2"
            >
              Without CovSight
            </th>
            <th
              scope="col"
              class="px-5 py-3 text-left font-semibold text-brand-700 dark:text-brand-400 bg-brand-50/60 dark:bg-brand-900/10 w-1/2"
            >
              With CovSight
            </th>
          </tr>
        </thead>
        <tbody class="bg-white dark:bg-navy-900 divide-y divide-slate-100 dark:divide-navy-700">
          {
            data.comparison.map((row) => (
              <tr class="group">
                <td class="px-5 py-3.5 text-slate-500 dark:text-slate-400">
                  <span class="flex items-start gap-2">
                    <span class="mt-0.5 text-red-400 flex-shrink-0" aria-hidden="true">✕</span>
                    {row.without}
                  </span>
                </td>
                <td class="px-5 py-3.5 text-slate-700 dark:text-slate-200 font-medium">
                  <span class="flex items-start gap-2">
                    <span class="mt-0.5 text-brand-500 flex-shrink-0" aria-hidden="true">✓</span>
                    {row.with}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

  </div>
</section>
