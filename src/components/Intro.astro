---
import CoverageFlow from '../diagrams/CoverageFlow.astro';
import introData from '../data/intro.yaml';

const intro = introData as {
  tagline: string;
  mission: string;
  cta_primary: { label: string; href: string };
  cta_secondary: { label: string; href: string };
  badges: string[];
};
---

<section
  id="top"
  class="relative min-h-screen flex items-center pt-16 bg-white dark:bg-navy-900 overflow-hidden"
  aria-label="Introduction"
>
  <!-- Subtle background grid pattern -->
  <div
    class="absolute inset-0 opacity-[0.03] dark:opacity-[0.06]"
    aria-hidden="true"
    style="background-image: linear-gradient(var(--color-brand) 1px, transparent 1px), linear-gradient(90deg, var(--color-brand) 1px, transparent 1px); background-size: 40px 40px;"
  ></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-16 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center">

    <!-- Left column: text -->
    <div>
      <h1 class="text-3xl sm:text-4xl xl:text-5xl font-bold text-slate-900 dark:text-white leading-tight tracking-tight">
        {intro.tagline}
      </h1>

      <p class="mt-6 text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-xl">
        {intro.mission}
      </p>

      <!-- CTA buttons -->
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={intro.cta_primary.href}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-colors shadow-sm"
        >
          {intro.cta_primary.label}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h12M7 1l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href={intro.cta_secondary.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-slate-300 dark:border-navy-700 text-slate-700 dark:text-slate-200 hover:border-brand-500 hover:text-brand-600 dark:hover:text-brand-400 font-semibold text-sm transition-colors"
        >
          <!-- GitHub icon -->
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          {intro.cta_secondary.label}
        </a>
      </div>

      <!-- Badge row -->
      <div class="mt-6 flex flex-wrap gap-2" aria-label="Technology badges">
        {
          intro.badges.map((badge) => (
            <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 dark:bg-navy-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-navy-700">
              {badge}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Right column: diagram -->
    <div class="flex justify-center lg:justify-end" aria-hidden="false">
      <CoverageFlow />
    </div>

    <!-- Scroll hint -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 opacity-40 dark:opacity-30 animate-bounce" aria-hidden="true">
      <span class="text-xs text-slate-500 dark:text-slate-400 tracking-widest uppercase">scroll</span>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400">
        <path d="M3 6l5 5 5-5"/>
      </svg>
    </div>
  </div>
</section>
