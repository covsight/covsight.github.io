---
import getStartedData from '../data/get-started.yaml';

const data = getStartedData as {
  heading: string;
  subheading: string;
  steps: { label: string; code: string }[];
  ctas: { label: string; href: string; primary: boolean }[];
  note: string;
};
---

<section
  id="get-started"
  class="py-20 bg-gradient-to-br from-brand-700 via-brand-800 to-navy-900 text-white"
  aria-labelledby="get-started-heading"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6">

    <div class="max-w-2xl">
      <h2
        id="get-started-heading"
        class="text-2xl sm:text-3xl font-bold"
      >
        {data.heading}
      </h2>
      <p class="mt-3 text-brand-200 text-base leading-relaxed">
        {data.subheading}
      </p>
    </div>

    <!-- Installation steps -->
    <div class="mt-8 flex flex-col gap-3 max-w-xl">
      {
        data.steps.map((step, i) => (
          <div class="flex items-start gap-4">
            <span
              class="shrink-0 mt-0.5 flex h-6 w-6 items-center justify-center rounded-full bg-brand-500/30 border border-brand-400/40 text-xs font-bold text-brand-200"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <div class="flex-1">
              <p class="text-xs font-medium text-brand-300 mb-1">{step.label}</p>
              <pre class="bg-navy-950/60 border border-white/10 rounded-lg px-4 py-2.5 text-sm font-mono text-brand-100 overflow-x-auto"><code>{step.code}</code></pre>
            </div>
          </div>
        ))
      }
    </div>

    <!-- CTAs -->
    <div class="mt-8 flex flex-wrap gap-3">
      {
        data.ctas.map((cta) =>
          cta.primary ? (
            <a
              href={cta.href}
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-white text-brand-800 font-semibold text-sm hover:bg-brand-50 transition-colors shadow"
            >
              {cta.label}
            </a>
          ) : (
            <a
              href={cta.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-white/30 text-white font-semibold text-sm hover:bg-white/10 transition-colors"
            >
              {cta.label}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/>
                <path d="M12 2A10 10 0 1 0 12 22A10 10 0 0 0 12 2M12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4M12 6C8.69 6 6 8.69 6 12C6 15.31 8.69 18 12 18C15.31 18 18 15.31 18 12C18 8.69 15.31 6 12 6M8.5 11H11V8H13V11H15.5L12 14.5L8.5 11Z"/>
              </svg>
            </a>
          )
        )
      }
    </div>

    <p class="mt-6 text-xs text-brand-400">{data.note}</p>

  </div>
</section>
