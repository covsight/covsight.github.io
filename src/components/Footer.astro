---
import navData from '../data/nav.yaml';
import trademarksData from '../data/trademarks.yaml';

const { footer_links } = navData as {
  footer_links: { label: string; href: string; external?: boolean }[];
};
const { notices } = trademarksData as { notices: string[] };

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 dark:border-navy-700 bg-slate-50 dark:bg-navy-900">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-6 text-sm text-slate-500 dark:text-slate-400">

    <!-- Left: copyright + license -->
    <div class="flex items-center gap-3">
      <span>&copy; {year} CovSight contributors</span>
      <span class="hidden sm:inline text-slate-300 dark:text-navy-700">·</span>
      <a
        href="https://www.apache.org/licenses/LICENSE-2.0"
        class="hover:text-slate-700 dark:hover:text-slate-200 transition-colors"
        target="_blank"
        rel="noopener noreferrer"
      >
        Apache-2.0
      </a>
    </div>

    <!-- Right: project links -->
    <nav aria-label="Footer navigation" class="flex flex-wrap justify-center gap-4">
      {
        footer_links.map((link) => (
          <a
            href={link.href}
            class="hover:text-slate-700 dark:hover:text-slate-200 transition-colors"
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <!-- Trademark notices -->
  <div class="border-t border-slate-200 dark:border-navy-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4">
      <p class="text-xs text-slate-400 dark:text-slate-600 leading-relaxed">
        {notices.join(' ')}
      </p>
    </div>
  </div>
</footer>
